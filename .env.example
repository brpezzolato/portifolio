# Copie para .env.local (nunca commite o .env.local).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. As duas são públicas por design;
# quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mails que podem abrir o painel /admin (separados por vírgula).
ADMIN_EMAILS=

# NÃO use a service_role key neste app: ela ignora o RLS inteiro.
